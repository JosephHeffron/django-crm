# Local/staging Caddyfile — for testing the full reverse-proxy/HTTPS/
# static-serving path itself, the same reasoning as compose.dev.yml
# (Phase 7 unit 2). There's no real public domain to test against
# locally, so `tls internal` tells Caddy to use its own local CA
# instead of attempting real ACME/Let's Encrypt — this is what
# Caddyfile (production) deliberately does NOT do, since a real
# deployment needs a publicly-trusted certificate, not a self-signed
# one.
localhost {
	tls internal

	encode gzip

	# See Caddyfile (production) for why these headers are scoped to
	# just the two file_server blocks rather than site-wide.
	handle_path /static/* {
		root * /srv/static
		file_server
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy same-origin
		}
	}

	# Same as the production Caddyfile: private media goes through
	# Django, which checks who's asking (apps/jobs/media.py).
	# Private media is NOT served from disk. Job photos and profile
	# pictures live under media/private/ and go through Django, which
	# checks who's asking and whether they may see the job the photo
	# belongs to (apps/jobs/media.py).
	#
	# This has to be a handle_path block, not a `respond` matcher.
	# Caddy sorts directives into its own order rather than running them
	# top to bottom, and `handle_path` sorts ahead of `respond`, so a
	# matcher written above the block below never ran — the first
	# version of this fix did exactly that, and served every private
	# photo with a 200.
	#
	# What makes this work is specificity, not position: Caddy orders
	# handle/handle_path blocks by how specific their path is, so
	# /media/private/* is tried before /media/* even though it could be
	# written after it. Don't rely on the order of these two blocks in
	# this file; `caddy adapt` shows the order that counts, and
	# apps/jobs/tests/test_private_media.py asserts it.
	handle_path /media/private/* {
		respond 404
	}

	handle_path /media/* {
		root * /srv/media
		file_server
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy same-origin
		}
	}

	handle {
		reverse_proxy web:8000
	}
}
