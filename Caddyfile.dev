# Local/staging Caddyfile — for testing the full reverse-proxy/HTTPS/
# static-serving path itself, the same reasoning as compose.dev.yml
# (Phase 7 unit 2). There's no real public domain to test against
# locally, so `tls internal` tells Caddy to use its own local CA
# instead of attempting real ACME/Let's Encrypt — this is what
# Caddyfile (production) deliberately does NOT do, since a real
# deployment needs a publicly-trusted certificate, not a self-signed
# one.
#
# The same two sites as production (docs/decisions/0016-two-sites-behind-one-caddy.md),
# with fixed local names instead of the {$CRM_HOST}/{$WEBSITE_HOST}
# variables:
#
#   https://localhost:8443/       the CRM
#   https://www.localhost:8443/   the website
#
# Browsers and curl resolve *.localhost to the loopback address without
# a hosts-file entry.
#
# One deliberate difference from production: here Caddy stays on the
# compose network and proxies to web:8000. Production runs Caddy on the
# host network and proxies to 127.0.0.1:8000, so that it sees real
# visitor addresses (docs/decisions/0022-caddy-on-the-host-network-for-real-client-addresses.md).
# On a workstation every visitor is you, and the host-network layout
# would collide with `manage.py runserver` on port 8000, so the dev
# stack does not reproduce it. The droplet is where that layout is
# proven (docs/ADMIN_GUIDE.md's verification step).

# See Caddyfile (production) for why headers are imported per handle
# block rather than set site-wide.
(secure_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
	}
}

(website_headers) {
	import secure_headers
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

localhost {
	tls internal

	encode gzip

	handle_path /static/* {
		root * /srv/static
		file_server
		import secure_headers
	}

	# Private media is NOT served from disk. Job photos and profile
	# pictures live under media/private/ and go through Django, which
	# checks who's asking and whether they may see the job the photo
	# belongs to (apps/jobs/media.py).
	#
	# This has to be a handle_path block, not a `respond` matcher.
	# Caddy sorts directives into its own order rather than running them
	# top to bottom, and `handle_path` sorts ahead of `respond`, so a
	# matcher written above the block below never ran — the first
	# version of this fix did exactly that, and served every private
	# photo with a 200.
	#
	# What makes this work is specificity, not position: Caddy orders
	# handle/handle_path blocks by how specific their path is, so
	# /media/private/* is tried before /media/* even though it could be
	# written after it. Don't rely on the order of these two blocks in
	# this file; `caddy adapt` shows the order that counts, and
	# apps/jobs/tests/test_private_media.py asserts it.
	handle_path /media/private/* {
		respond 404
	}

	handle_path /media/* {
		root * /srv/media
		file_server
		import secure_headers
	}

	handle {
		reverse_proxy web:8000
	}
}

# The website, exactly as in the production Caddyfile — see the
# comments there.
www.localhost {
	tls internal

	encode gzip

	handle /partials/* {
		error 404
	}

	handle /assets/* {
		root * /srv/website
		file_server
		import website_headers
	}

	handle {
		root * /srv/website
		try_files {path} {path}.html
		templates {
			mime text/html
		}
		file_server
		import website_headers
	}

	handle_errors {
		@missing expression `{err.status_code} == 404`
		handle @missing {
			root * /srv/website
			rewrite * /404.html
			templates {
				mime text/html
			}
			file_server
			import website_headers
		}
	}
}
