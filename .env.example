# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# Django
#
# DJANGO_SETTINGS_MODULE is deliberately NOT set here. manage.py/wsgi.py
# already default it to config.settings.development when unset, which is
# correct for native dev; the Containerfile bakes in
# config.settings.production for containers. Setting it explicitly in
# .env would override BOTH of those correct defaults via env_file (an
# env var from env_file wins over an image's own ENV) — confirmed live
# during Phase 8 unit 2's review: a .env with this line copied verbatim
# made the *production* container silently boot with DEBUG=True and
# SECURE_SSL_REDIRECT=False. Don't add this var back without
# re-verifying that reasoning no longer applies.
DJANGO_SECRET_KEY=change-me-to-a-random-value

# Only required when DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com

# Optional branding and business timezone (defaults shown). The short
# name appears under the home-screen icon when the app is installed on
# a phone — keep it to ~12 characters.
#CRM_BRAND_NAME=Exterior CRM
#CRM_BRAND_SHORT_NAME=Exterior CRM
#CRM_TIME_ZONE=America/New_York
# Address for the sidebar's Ideas / Report a bug links and the help
# button (left blank, those links are hidden).
#CRM_SUPPORT_EMAIL=you@example.com

# PostgreSQL
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
# localhost/5432 is correct for native local dev (a locally-installed
# PostgreSQL). compose.dev.yml/compose.prod.yml override POSTGRES_HOST
# to "db" (the compose service name) for the containerized `web`
# service — these two values here are only ever used as-is by native
# dev and by the `db` service itself (which ignores them).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Off-host backup storage (Phase 15, docs/decisions/0006-offhost-backups-restic.md)
#
# Optional. scripts/backup.sh skips the off-host push entirely if
# RESTIC_REPOSITORY is unset below — local-only backup behavior is
# unchanged from before Phase 15. Requires the `restic` binary
# installed on this host (not in any container) — see
# docs/ADMIN_GUIDE.md's "Backups" section for install/setup steps.
#
# RESTIC_PASSWORD encrypts the ENTIRE backup client-side, before it
# ever leaves this host — restic refuses to operate without it, and
# there is no "forgot password" recovery: losing it makes every
# off-host backup permanently unreadable. Generate a strong one (e.g.
# `openssl rand -base64 32`) and keep a copy somewhere OTHER than this
# .env/this host — a password manager, printed and stored safely —
# since a copy that only lives on the same host defeats the point of
# an off-host backup protecting against losing that host.
#RESTIC_REPOSITORY=b2:your-bucket-name:django-crm
#RESTIC_PASSWORD=change-me-to-a-long-random-value

# Backblaze B2 application key, scoped to ONLY the bucket named in
# RESTIC_REPOSITORY above (B2's "Application Keys" page — select that
# one bucket, not "all buckets") — never the account's master key.
#B2_ACCOUNT_ID=change-me
#B2_ACCOUNT_KEY=change-me

# Defaults to "django-crm". Only change this if the SAME restic
# repository/bucket is ever shared by more than one deployment of this
# project (e.g. a staging copy using the same bucket) — retention
# (`restic forget --keep-last`) and restore_offhost.sh's snapshot
# selection are scoped by this tag, so two deployments sharing one tag
# in one repository could prune or restore each other's snapshots.
#RESTIC_TAG=django-crm
