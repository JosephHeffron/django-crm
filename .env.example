# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-random-value

# Only required when DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com

# PostgreSQL
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
# localhost/5432 is correct for native local dev (a locally-installed
# PostgreSQL). compose.dev.yml/compose.prod.yml override POSTGRES_HOST
# to "db" (the compose service name) for the containerized `web`
# service — these two values here are only ever used as-is by native
# dev and by the `db` service itself (which ignores them).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
