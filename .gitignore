# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# pyenv (keep .python-version tracked; ignore any local pyenv caches)

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# Django
*.sqlite3
/media/
/staticfiles/
local_settings.py

# Database dumps / backups
*.sql
*.sql.gz
*.dump
*.backup

# Deployment state (scripts/deploy.sh's rollback marker — host-local,
# never meaningful to commit)
/.deploy-last-good-ref

# Test / coverage artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
nosetests.xml
coverage.xml

# IDE / editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store

# Claude Code — machine-local overrides, never shared
.claude/settings.local.json

# Container / application runtime logs (the tracked docs/decisions,
# logs/claude, logs/git, logs/failures, logs/system trees use .md and are
# intentionally NOT covered by this rule)
*.log
*.pid
containers/**/*.local
